{
  "action": {
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "BadgeifyV2"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "content/content.js"
      ],
      "matches": [
        "https://discord.com/*",
        "https://ptb.discord.com/*",
        "https://canary.discord.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "Simulate game sessions and playtime activity to progress Discord badges. By TANK49 - tank49.tech",
  "host_permissions": [
    "https://*.discord.com/*",
    "https://discord.com/*",
    "https://ptb.discord.com/*",
    "https://canary.discord.com/*",
    "https://cdn.discordapp.com/*",
    "https://cordapi.dolfi.es/*"
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "key": "",
  "manifest_version": 3,
  "name": "BadgeifyV2",
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "notifications",
    "offscreen"
  ],
  "update_url": "https://clients2.google.com/service/update2/crx",
  "version": "2.0",
  "web_accessible_resources": [
    {
      "matches": [
        "https://*.discord.com/*",
        "https://discord.com/*",
        "https://ptb.discord.com/*",
        "https://canary.discord.com/*"
      ],
      "resources": [
        "assets/*",
        "data/*",
        "content/injector.js"
      ]
    }
  ]
}
